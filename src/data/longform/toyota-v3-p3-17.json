  "cues": [
    {
      "start": 0.4,
      "end": 2.562,
      "speaker": "ナレ2",
      "text": "トヨタのハイブリッド車は、",
      "lineId": "v3-p3-17-l1"
    },
    {
      "start": 2.562,
      "end": 5.224,
      "speaker": "ナレ2",
      "text": "2007年5月に累計100万台。",
      "lineId": "v3-p3-17-l1"
    },
    {
      "start": 5.224,
      "end": 7.552,
      "speaker": "ナレ2",
      "text": "2009年9月に200万台、",
      "lineId": "v3-p3-17-l1"
    },
    {
      "start": 7.552,
      "end": 9.049,
      "speaker": "ナレ2",
      "text": "2011年2月には",
      "lineId": "v3-p3-17-l1"
    },
    {
      "start": 9.049,
      "end": 11.045,
      "speaker": "ナレ2",
      "text": "300万台を超えました。",
      "lineId": "v3-p3-17-l1"
    },
    {
      "start": 11.495,
      "end": 13.75,
      "speaker": "ホーマー",
      "text": "線が少しずつ上へ伸びていきますね。",
      "lineId": "v3-p3-17-l2"
    },
    {
      "start": 13.75,
      "end": 14.281,
      "speaker": "ホーマー",
      "text": "これは、",
      "lineId": "v3-p3-17-l2"
    },
    {
      "start": 14.281,
      "end": 16.669,
      "speaker": "ホーマー",
      "text": "それぞれの年に売れた台数でしょうか。",
      "lineId": "v3-p3-17-l2"
    },
    {
      "start": 17.119,
      "end": 18.551,
      "speaker": "ケント",
      "text": "発売以来の合計です。",
      "lineId": "v3-p3-17-l3"
    },
    {
      "start": 18.551,
      "end": 20.985,
      "speaker": "ケント",
      "text": "2009年に200万台とあるのは、",
      "lineId": "v3-p3-17-l3"
    },
    {
      "start": 20.985,
      "end": 23.133,
      "speaker": "ケント",
      "text": "その年だけで200万台売れたと",
      "lineId": "v3-p3-17-l3"
    },
    {
      "start": 23.133,
      "end": 24.852,
      "speaker": "ケント",
      "text": "いう意味ではありません。",
      "lineId": "v3-p3-17-l3"
    },
    {
      "start": 25.302,
      "end": 27.023,
      "speaker": "ジャッド",
      "text": "同じ「万台」でも、",
      "lineId": "v3-p3-17-l4"
    },
    {
      "start": 27.023,
      "end": 29.127,
      "speaker": "ジャッド",
      "text": "年間なのか累計なのかで",
      "lineId": "v3-p3-17-l4"
    },
    {
      "start": 29.127,
      "end": 31.613,
      "speaker": "ジャッド",
      "text": "受け取り方が変わりますね。",
      "lineId": "v3-p3-17-l4"
    },
    {
      "start": 31.613,
      "end": 34.099,
      "speaker": "ジャッド",
      "text": "数字だけを大きく出しても、",
      "lineId": "v3-p3-17-l4"
    },
    {
      "start": 34.099,
      "end": 36.011,
      "speaker": "ジャッド",
      "text": "それでは分からない。",
      "lineId": "v3-p3-17-l4"
    }
  ]
