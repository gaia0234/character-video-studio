  "cues": [
    {
      "start": 0.4,
      "end": 2.405,
      "speaker": "ジャッド",
      "text": "車種も工場も広がった。",
      "lineId": "v3-p3-19-l1"
    },
    {
      "start": 2.405,
      "end": 2.952,
      "speaker": "ジャッド",
      "text": "では、",
      "lineId": "v3-p3-19-l1"
    },
    {
      "start": 2.952,
      "end": 6.05,
      "speaker": "ジャッド",
      "text": "トヨタだけがその技術を使い続ける、",
      "lineId": "v3-p3-19-l1"
    },
    {
      "start": 6.05,
      "end": 8.784,
      "speaker": "ジャッド",
      "text": "という考えだったんでしょうか。",
      "lineId": "v3-p3-19-l1"
    },
    {
      "start": 9.234,
      "end": 11.221,
      "speaker": "ホーマー",
      "text": "開発に手間をかけた技術ですから、",
      "lineId": "v3-p3-19-l2"
    },
    {
      "start": 11.221,
      "end": 12.711,
      "speaker": "ホーマー",
      "text": "普通は自分の会社で大事に",
      "lineId": "v3-p3-19-l2"
    },
    {
      "start": 12.711,
      "end": 14.45,
      "speaker": "ホーマー",
      "text": "持っておきたい気もしますね。",
      "lineId": "v3-p3-19-l2"
    },
    {
      "start": 14.9,
      "end": 16.478,
      "speaker": "ケント",
      "text": "そこで次に見るのが、",
      "lineId": "v3-p3-19-l3"
    },
    {
      "start": 16.478,
      "end": 19.477,
      "speaker": "ケント",
      "text": "特許を無償で使えるようにする発表です。",
      "lineId": "v3-p3-19-l3"
    },
    {
      "start": 19.477,
      "end": 21.687,
      "speaker": "ケント",
      "text": "ただ、「全部を誰にでも無料で",
      "lineId": "v3-p3-19-l3"
    },
    {
      "start": 21.687,
      "end": 23.423,
      "speaker": "ケント",
      "text": "渡した」とまとめると、",
      "lineId": "v3-p3-19-l3"
    },
    {
      "start": 23.423,
      "end": 25.001,
      "speaker": "ケント",
      "text": "正確ではありません。",
      "lineId": "v3-p3-19-l3"
    },
    {
      "start": 25.451,
      "end": 27.315,
      "speaker": "ジャッド",
      "text": "無料という言葉だけでは",
      "lineId": "v3-p3-19-l4"
    },
    {
      "start": 27.315,
      "end": 29.178,
      "speaker": "ジャッド",
      "text": "判断できないんですね。",
      "lineId": "v3-p3-19-l4"
    },
    {
      "start": 29.178,
      "end": 32.057,
      "speaker": "ジャッド",
      "text": "何が対象で、どんな条件があるのか、",
      "lineId": "v3-p3-19-l4"
    },
    {
      "start": 32.057,
      "end": 33.921,
