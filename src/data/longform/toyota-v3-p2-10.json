    {
      "start": 0.4,
      "end": 2.267,
      "speaker": "ジャッド",
      "text": "ブレーキで電気が戻るなら、",
      "lineId": "v3-p2-10-l1"
    },
    {
      "start": 2.267,
      "end": 3.846,
      "speaker": "ジャッド",
      "text": "走り続けるうちに電池が",
      "lineId": "v3-p2-10-l1"
    },
    {
      "start": 3.846,
      "end": 6.0,
      "speaker": "ジャッド",
      "text": "どんどん満タンになりませんか。",
      "lineId": "v3-p2-10-l1"
    },
    {
      "start": 6.45,
      "end": 8.208,
      "speaker": "ケント",
      "text": "回収できるのは一部です。",
      "lineId": "v3-p2-10-l2"
    },
    {
      "start": 8.208,
      "end": 9.527,
      "speaker": "ケント",
      "text": "使ったエネルギーが",
      "lineId": "v3-p2-10-l2"
    },
    {
      "start": 9.527,
      "end": 11.579,
      "speaker": "ケント",
      "text": "全部戻るわけではありません。",
      "lineId": "v3-p2-10-l2"
    },
    {
