      "end": 12.898,
      "speaker": "ケント",
      "text": "ガソリンを使わず、",
      "lineId": "v3-p2-10-l2"
    },
    {
      "start": 12.898,
      "end": 15.389,
      "speaker": "ケント",
      "text": "永久に走れる仕組みではないんです。",
      "lineId": "v3-p2-10-l2"
    },
