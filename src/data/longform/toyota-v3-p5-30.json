    },
    {
      "start": 4.304,
      "end": 6.907,
      "speaker": "ジャッド",
      "text": "と決めないほうがよさそうですね。",
      "lineId": "v3-p5-30-l1"
    },
    {
      "start": 7.357,
      "end": 7.862,
      "speaker": "ケント",
      "text": "はい。",
