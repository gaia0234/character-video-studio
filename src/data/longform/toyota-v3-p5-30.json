    {
      "start": 0.4,
      "end": 2.677,
      "speaker": "ジャッド",
      "text": "一つの数字だけを取り出して、",
      "lineId": "v3-p5-30-l1"
    },
    {
      "start": 2.677,
      "end": 4.304,
      "speaker": "ジャッド",
      "text": "どの車が絶対によい、",
