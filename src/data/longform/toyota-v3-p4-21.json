      "start": 10.567,
      "end": 11.731,
      "speaker": "ジャッド",
      "text": "使いたい人が、",
      "lineId": "v3-p4-21-l2"
    },
    {
      "start": 11.731,
      "end": 14.556,
      "speaker": "ジャッド",
      "text": "勝手に使ってよいという意味ですか。",
      "lineId": "v3-p4-21-l2"
