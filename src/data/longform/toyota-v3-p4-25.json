  "cues": [
    {
      "start": 0.4,
      "end": 2.786,
      "speaker": "ホーマー",
      "text": "そうやって他社にも広げようとしたのは、",
      "lineId": "v3-p4-25-l1"
    },
    {
      "start": 2.786,
      "end": 3.665,
      "speaker": "ホーマー",
      "text": "なぜでしょう。",
      "lineId": "v3-p4-25-l1"
    },
    {
      "start": 3.665,
      "end": 5.297,
      "speaker": "ホーマー",
      "text": "自分の会社だけで使うより、",
      "lineId": "v3-p4-25-l1"
    },
    {
      "start": 5.297,
      "end": 7.557,
      "speaker": "ホーマー",
      "text": "得るものがあると考えたんでしょうか。",
      "lineId": "v3-p4-25-l1"
    },
    {
      "start": 8.007,
      "end": 9.124,
      "speaker": "ケント",
      "text": "公式発表では、",
      "lineId": "v3-p4-25-l2"
    },
    {
      "start": 9.124,
      "end": 12.156,
      "speaker": "ケント",
      "text": "電動車を広く普及させる役割を担いたい、",
      "lineId": "v3-p4-25-l2"
    },
    {
      "start": 12.156,
      "end": 14.55,
      "speaker": "ケント",
      "text": "という考えが説明されています。",
      "lineId": "v3-p4-25-l2"
    },
    {
      "start": 14.55,
      "end": 17.103,
      "speaker": "ケント",
      "text": "ただ、それ以外の会社の狙いまで、",
      "lineId": "v3-p4-25-l2"
    },
    {
      "start": 17.103,
      "end": 19.815,
      "speaker": "ケント",
      "text": "ここで決めつけることはできません。",
      "lineId": "v3-p4-25-l2"
    },
    {
      "start": 20.265,
      "end": 22.285,
      "speaker": "ジャッド",
      "text": "発表に何と書いてあるかと、",
      "lineId": "v3-p4-25-l3"
    },
    {
      "start": 22.285,
      "end": 24.46,
      "speaker": "ジャッド",
      "text": "それを見てどう評価するかは、",
      "lineId": "v3-p4-25-l3"
    },
    {
      "start": 24.46,
      "end": 26.324,
      "speaker": "ジャッド",
      "text": "分けるということですね。",
      "lineId": "v3-p4-25-l3"
    },
    {
      "start": 26.774,
      "end": 27.219,
      "speaker": "ケント",
      "text": "ええ。",
      "lineId": "v3-p4-25-l4"
    },
    {
      "start": 27.219,
      "end": 30.038,
      "speaker": "ケント",
      "text": "特許を開いたことだけが販売を伸ばした、",
      "lineId": "v3-p4-25-l4"
    },
    {
      "start": 30.038,
      "end": 31.225,
      "speaker": "ケント",
      "text": "とも言えません。",
      "lineId": "v3-p4-25-l4"
    },
    {
      "start": 31.225,
      "end": 31.967,
      "speaker": "ケント",
      "text": "ここでは、",
      "lineId": "v3-p4-25-l4"
    },
    {
      "start": 31.967,
      "end": 34.637,
      "speaker": "ケント",
      "text": "技術を自社の外へ広げる選択もあった、",
      "lineId": "v3-p4-25-l4"
    },
    {
      "start": 34.637,
      "end": 36.566,
      "speaker": "ケント",
      "text": "という点を押さえましょう。",
      "lineId": "v3-p4-25-l4"
    }
  ]
