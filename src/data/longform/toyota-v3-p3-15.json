  "cues": [
    {
      "start": 0.4,
      "end": 2.072,
      "speaker": "ホーマー",
      "text": "プリウスの形や大きさが自分の",
      "lineId": "v3-p3-15-l1"
    },
    {
      "start": 2.072,
      "end": 3.983,
      "speaker": "ホーマー",
      "text": "使い方に合わない人もいますよね。",
      "lineId": "v3-p3-15-l1"
    },
    {
      "start": 3.983,
      "end": 4.699,
      "speaker": "ホーマー",
      "text": "ほかの車には",
      "lineId": "v3-p3-15-l1"
    },
    {
      "start": 4.699,
      "end": 6.491,
      "speaker": "ホーマー",
      "text": "載せられなかったんでしょうか。",
      "lineId": "v3-p3-15-l1"
    },
    {
      "start": 6.941,
      "end": 8.148,
      "speaker": "ケント",
      "text": "広がっています。",
      "lineId": "v3-p3-15-l2"
    },
    {
      "start": 8.148,
      "end": 10.864,
      "speaker": "ケント",
      "text": "2001年にはミニバンのエスティマ。",
      "lineId": "v3-p3-15-l2"
    },
    {
      "start": 10.864,
      "end": 13.429,
      "speaker": "ケント",
      "text": "2005年にはSUV、2006年、",
      "lineId": "v3-p3-15-l2"
    },
    {
      "start": 13.429,
      "end": 15.24,
      "speaker": "ケント",
      "text": "2007年にはレクサスの",
      "lineId": "v3-p3-15-l2"
    },
    {
      "start": 15.24,
      "end": 17.202,
      "speaker": "ケント",
      "text": "セダンにも採用されました。",
      "lineId": "v3-p3-15-l2"
    },
    {
      "start": 17.652,
      "end": 19.611,
      "speaker": "ジャッド",
      "text": "小さな専用車だけの話で",
      "lineId": "v3-p3-15-l3"
    },
    {
      "start": 19.611,
      "end": 21.57,
      "speaker": "ジャッド",
      "text": "はなくなったんですね。",
      "lineId": "v3-p3-15-l3"
    },
    {
      "start": 21.57,
      "end": 22.817,
      "speaker": "ジャッド",
      "text": "家族で使う車、",
      "lineId": "v3-p3-15-l3"
    },
    {
      "start": 22.817,
      "end": 25.311,
      "speaker": "ジャッド",
      "text": "大きな車にも選択肢ができた。",
      "lineId": "v3-p3-15-l3"
    },
    {
      "start": 25.761,
      "end": 27.333,
      "speaker": "ケント",
      "text": "車種の広がりを見ると、",
      "lineId": "v3-p3-15-l4"
    },
    {
      "start": 27.333,
      "end": 28.62,
      "speaker": "ケント",
      "text": "販売の数字だけでは",
      "lineId": "v3-p3-15-l4"
    },
    {
      "start": 28.62,
      "end": 30.764,
      "speaker": "ケント",
      "text": "分からない変化が見えてきます。",
      "lineId": "v3-p3-15-l4"
    },
    {
      "start": 30.764,
      "end": 31.336,
      "speaker": "ケント",
      "text": "ただし、",
      "lineId": "v3-p3-15-l4"
    },
    {
      "start": 31.336,
      "end": 33.624,
      "speaker": "ケント",
      "text": "それだけで売れた理由を全部説明で",
      "lineId": "v3-p3-15-l4"
    },
    {
      "start": 33.624,
      "end": 35.339,
      "speaker": "ケント",
      "text": "きるわけではありません。",
      "lineId": "v3-p3-15-l4"
    }
  ]
