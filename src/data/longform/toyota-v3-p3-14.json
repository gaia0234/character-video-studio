    {
      "start": 0.4,
      "end": 1.956,
      "speaker": "ナレ2",
      "text": "2003年9月には",
      "lineId": "v3-p3-14-l1"
    },
    {
      "start": 1.956,
      "end": 3.857,
      "speaker": "ナレ2",
      "text": "第2代プリウスが登場。",
      "lineId": "v3-p3-14-l1"
    },
    {
      "start": 3.857,
      "end": 6.622,
      "speaker": "ナレ2",
      "text": "システムはTHS IIへ進化し、",
      "lineId": "v3-p3-14-l1"
    },
    {
      "start": 6.622,
      "end": 9.733,
      "speaker": "ナレ2",
      "text": "モーターの出力向上などが進みました。",
      "lineId": "v3-p3-14-l1"
    },
    {
      "start": 10.183,
      "end": 12.476,
      "speaker": "ジャッド",
      "text": "見た目だけが新しくなったわけで",
      "lineId": "v3-p3-14-l2"
    },
    {
      "start": 12.476,
      "end": 13.698,
      "speaker": "ジャッド",
      "text": "はないんですね。",
      "lineId": "v3-p3-14-l2"
    },
    {
      "start": 13.698,
      "end": 16.296,
      "speaker": "ジャッド",
      "text": "ハイブリッドという名前は同じでも、",
      "lineId": "v3-p3-14-l2"
    },
    {
      "start": 16.296,
      "end": 17.671,
      "speaker": "ジャッド",
      "text": "中は変わっている。",
      "lineId": "v3-p3-14-l2"
    },
    {
      "start": 18.121,
      "end": 18.584,
      "speaker": "ケント",
      "text": "ええ。",
      "lineId": "v3-p3-14-l3"
    },
    {
      "start": 18.584,
      "end": 21.205,
      "speaker": "ケント",
      "text": "初代の仕組みをそのまま長く売った、",
      "lineId": "v3-p3-14-l3"
    },
    {
      "start": 21.205,
      "end": 23.517,
      "speaker": "ケント",
      "text": "と考えると歩みを見落とします。",
      "lineId": "v3-p3-14-l3"
    },
    {
      "start": 23.517,
      "end": 26.292,
      "speaker": "ケント",
      "text": "電気を扱う部分も改良されてきました。",
      "lineId": "v3-p3-14-l3"
    },
    {
      "start": 26.742,
      "end": 28.541,
      "speaker": "ホーマー",
      "text": "一度作って終わりではなく、",
      "lineId": "v3-p3-14-l4"
