  "cues": [
    {
      "start": 0.4,
      "end": 2.245,
      "speaker": "ケント",
      "text": "次に電動車を見るときは、",
      "lineId": "v3-p5-33-l1"
    },
    {
      "start": 2.245,
      "end": 4.552,
      "speaker": "ケント",
      "text": "三つだけ確かめてみてください。",
      "lineId": "v3-p5-33-l1"
    },
    {
      "start": 4.552,
      "end": 5.628,
      "speaker": "ケント",
      "text": "何で走るのか。",
      "lineId": "v3-p5-33-l1"
    },
    {
      "start": 5.628,
      "end": 8.088,
      "speaker": "ケント",
      "text": "エネルギーをどこから入れるのか。",
      "lineId": "v3-p5-33-l1"
    },
    {
      "start": 8.088,
      "end": 10.395,
      "speaker": "ケント",
      "text": "そして、比べている条件は何か。",
      "lineId": "v3-p5-33-l1"
    },
    {
      "start": 10.845,
      "end": 12.245,
      "speaker": "ホーマー",
      "text": "技術の名前だけでなく、",
      "lineId": "v3-p5-33-l2"
    },
    {
      "start": 12.245,
      "end": 13.901,
      "speaker": "ホーマー",
      "text": "暮らしの中でどう使えるかを",
      "lineId": "v3-p5-33-l2"
    },
    {
      "start": 13.901,
      "end": 14.919,
      "speaker": "ホーマー",
      "text": "見るわけですね。",
      "lineId": "v3-p5-33-l2"
    },
    {
      "start": 15.369,
      "end": 16.746,
      "speaker": "ジャッド",
      "text": "今日の話を知ると、",
      "lineId": "v3-p5-33-l3"
    },
    {
      "start": 16.746,
      "end": 19.194,
      "speaker": "ジャッド",
      "text": "ハイブリッドという言葉の中にも、",
      "lineId": "v3-p5-33-l3"
    },
    {
      "start": 19.194,
      "end": 21.641,
      "speaker": "ジャッド",
      "text": "まだ確かめることがありそうです。",
      "lineId": "v3-p5-33-l3"
    },
    {
      "start": 22.091,
      "end": 24.492,
      "speaker": "ナレ2",
      "text": "1997年のプリウスから、",
      "lineId": "v3-p5-33-l4"
    },
    {
      "start": 24.492,
      "end": 26.893,
      "speaker": "ナレ2",
      "text": "車種の広がり、技術の開放、",
      "lineId": "v3-p5-33-l4"
    },
    {
      "start": 26.893,
      "end": 29.11,
      "speaker": "ナレ2",
      "text": "そして新しいPHEVへ。",
      "lineId": "v3-p5-33-l4"
    },
    {
      "start": 29.11,
      "end": 30.957,
      "speaker": "ナレ2",
      "text": "一台の車だけでなく、",
      "lineId": "v3-p5-33-l4"
    },
    {
      "start": 30.957,
      "end": 33.358,
      "speaker": "ナレ2",
      "text": "つながる技術として見ると、",
      "lineId": "v3-p5-33-l4"
    },
    {
      "start": 33.358,
      "end": 35.574,
      "speaker": "ナレ2",
      "text": "その歩みが見えてきます。",
      "lineId": "v3-p5-33-l4"
    }
  ]
