  "cues": [
    {
      "start": 0.4,
      "end": 2.349,
      "speaker": "ナレ2",
      "text": "2025年5月21日、",
      "lineId": "v3-p5-31-l1"
    },
    {
      "start": 2.349,
      "end": 5.362,
      "speaker": "ナレ2",
      "text": "トヨタは新型RAV4を世界初公開。",
      "lineId": "v3-p5-31-l1"
    },
    {
      "start": 5.362,
      "end": 6.425,
      "speaker": "ナレ2",
      "text": "PHEVに、",
      "lineId": "v3-p5-31-l1"
    },
    {
      "start": 6.425,
      "end": 9.793,
      "speaker": "ナレ2",
      "text": "トヨタとして初めて第6世代ハイブリッド",
      "lineId": "v3-p5-31-l1"
    },
    {
      "start": 9.793,
      "end": 12.805,
      "speaker": "ナレ2",
      "text": "システムを搭載すると発表しました。",
      "lineId": "v3-p5-31-l1"
    },
    {
      "start": 13.255,
      "end": 14.641,
      "speaker": "ホーマー",
      "text": "外から充電する車にも、",
      "lineId": "v3-p5-31-l2"
    },
    {
      "start": 14.641,
      "end": 16.027,
      "speaker": "ホーマー",
      "text": "ハイブリッドの仕組みを",
      "lineId": "v3-p5-31-l2"
    },
    {
      "start": 16.027,
      "end": 17.917,
      "speaker": "ホーマー",
      "text": "改良してつないでいるんですね。",
      "lineId": "v3-p5-31-l2"
    },
    {
      "start": 18.367,
      "end": 20.476,
      "speaker": "ジャッド",
      "text": "ただ、第6世代というだけで、",
      "lineId": "v3-p5-31-l3"
    },
    {
      "start": 20.476,
      "end": 23.338,
      "speaker": "ジャッド",
      "text": "すべてのハイブリッド車が一斉に変わった",
      "lineId": "v3-p5-31-l3"
    },
    {
      "start": 23.338,
      "end": 25.748,
      "speaker": "ジャッド",
      "text": "と思わないほうがよいんでしょう。",
      "lineId": "v3-p5-31-l3"
    },
    {
      "start": 26.198,
      "end": 27.465,
      "speaker": "ケント",
      "text": "そのとおりです。",
      "lineId": "v3-p5-31-l4"
    },
    {
      "start": 27.465,
      "end": 29.366,
      "speaker": "ケント",
      "text": "ここで確認しているのは、",
      "lineId": "v3-p5-31-l4"
    },
    {
      "start": 29.366,
      "end": 31.109,
      "speaker": "ケント",
      "text": "この発表でのPHEVへ",
      "lineId": "v3-p5-31-l4"
    },
    {
      "start": 31.109,
      "end": 33.01,
      "speaker": "ケント",
      "text": "の初搭載という範囲です。",
      "lineId": "v3-p5-31-l4"
    },
    {
      "start": 33.01,
      "end": 34.435,
      "speaker": "ケント",
      "text": "名前だけを広げず、",
      "lineId": "v3-p5-31-l4"
    },
    {
      "start": 34.435,
      "end": 36.811,
      "speaker": "ケント",
      "text": "どの車の話かを添えておきます。",
      "lineId": "v3-p5-31-l4"
    }
  ]
