    {
      "start": 0.4,
      "end": 2.961,
      "speaker": "ホーマー",
      "text": "環境のことなら、走っているときに排気が",
      "lineId": "v3-p5-29-l1"
    },
    {
      "start": 2.961,
      "end": 4.308,
      "speaker": "ホーマー",
      "text": "出ないBEVがよい、",
      "lineId": "v3-p5-29-l1"
    },
    {
      "start": 4.308,
      "end": 5.925,
      "speaker": "ホーマー",
      "text": "という見方もありますね。",
      "lineId": "v3-p5-29-l1"
    },
    {
      "start": 6.375,
      "end": 8.258,
      "speaker": "ケント",
      "text": "走行時に排気が出ないの",
