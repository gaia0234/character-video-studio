    {
      "start": 0.4,
      "end": 3.063,
      "speaker": "ナレ2",
      "text": "2019年4月、今度は電動化に",
      "lineId": "v3-p4-23-l1"
    },
    {
      "start": 3.063,
      "end": 6.435,
      "speaker": "ナレ2",
      "text": "関わる約23,740件の特許について、",
      "lineId": "v3-p4-23-l1"
    },
    {
      "start": 6.435,
      "end": 9.808,
      "speaker": "ナレ2",
      "text": "無償で使用を許諾する発表がありました。",
      "lineId": "v3-p4-23-l1"
    },
    {
      "start": 10.258,
      "end": 11.569,
      "speaker": "ケント",
      "text": "モーター、電力を",
      "lineId": "v3-p4-23-l2"
    },
    {
      "start": 11.569,
      "end": 14.517,
      "speaker": "ケント",
      "text": "調整するパワーコントロールユニット、",
      "lineId": "v3-p4-23-l2"
    },
    {
      "start": 14.517,
      "end": 16.811,
      "speaker": "ケント",
      "text": "システム制御などが対象です。",
      "lineId": "v3-p4-23-l2"
    },
    {
      "start": 16.811,
      "end": 19.268,
      "speaker": "ケント",
      "text": "発表された期限は2030年末。",
      "lineId": "v3-p4-23-l2"
    },
    {
      "start": 19.268,
      "end": 21.234,
      "speaker": "ケント",
      "text": "こちらも契約が必要です。",
      "lineId": "v3-p4-23-l2"
    },
    {
      "start": 21.684,
      "end": 23.934,
      "speaker": "ジャッド",
      "text": "今度は水素の車だけではなく、",
      "lineId": "v3-p4-23-l3"
    },
