  "cues": [
    {
      "start": 0.4,
      "end": 1.4288761904761906,
      "speaker": "ホーマー",
      "text": "このプリウスは、",
      "lineId": "v3-p1-02-l1"
    },
    {
      "start": 1.4288761904761906,
      "end": 4.9013333333333335,
      "speaker": "ホーマー",
      "text": "家のコンセントにつないで充電する車ではないんですよね。",
      "lineId": "v3-p1-02-l1"
    },
    {
      "start": 5.351333333333334,
      "end": 9.32869918699187,
      "speaker": "ケント",
      "text": "はい。エンジンで発電した電気を、電池にためます。",
      "lineId": "v3-p1-02-l2"
    },
    {
      "start": 9.32869918699187,
      "end": 12.146,
      "speaker": "ケント",
      "text": "電気が入る道は、もう1つあります。",
      "lineId": "v3-p1-02-l2"
    },
    {
      "start": 12.596,
      "end": 14.334666666666667,
      "speaker": "ホーマー",
      "text": "もう1つは、どこから？",
      "lineId": "v3-p1-02-l3"
    },
    {
      "start": 14.784666666666666,
      "end": 16.518367816091953,
      "speaker": "ケント",
      "text": "車が減速するときです。",
      "lineId": "v3-p1-02-l4"
    },
    {
      "start": 16.518367816091953,
      "end": 20.143379310344827,
      "speaker": "ケント",
      "text": "車が動いているエネルギーの一部を電気に変えて、",
      "lineId": "v3-p1-02-l4"
    },
    {
      "start": 20.143379310344827,
      "end": 23.926000000000002,
      "speaker": "ケント",
      "text": "電池へ戻します。これを、回生ブレーキといいます。",
      "lineId": "v3-p1-02-l4"
    },
    {
      "start": 24.375999999999998,
      "end": 25.99733333333333,
      "speaker": "ホーマー",
      "text": "止まるときにも、ですか。",
      "lineId": "v3-p1-02-l5"
    },
    {
      "start": 25.99733333333333,
      "end": 28.29422222222222,
      "speaker": "ホーマー",
      "text": "信号で何度もブレーキを踏む道なら、",
      "lineId": "v3-p1-02-l5"
    },
    {
      "start": 28.29422222222222,
      "end": 30.86133333333333,
      "speaker": "ホーマー",
      "text": "そのたびに取り戻せる分があるんですね。",
      "lineId": "v3-p1-02-l5"
    },
    {
      "start": 31.31133333333333,
      "end": 33.64045161290322,
      "speaker": "ジャッド",
      "text": "そちらは気になります。ただ、",
      "lineId": "v3-p1-02-l6"
    },
    {
      "start": 33.64045161290322,
      "end": 37.30049462365591,
      "speaker": "ジャッド",
      "text": "エンジンで発電するほうは燃料を使いますよね。",
      "lineId": "v3-p1-02-l6"
    },
    {
      "start": 37.30049462365591,
      "end": 41.626,
      "speaker": "ジャッド",
      "text": "電池があるだけでは、節約になるとは言えないでしょう。",
      "lineId": "v3-p1-02-l6"
    },
    {
      "start": 42.07599999999999,
      "end": 43.64881045751633,
      "speaker": "ケント",
      "text": "はい。電気を作れば、",
      "lineId": "v3-p1-02-l7"
    },
    {
      "start": 43.64881045751633,
      "end": 47.58083660130718,
      "speaker": "ケント",
      "text": "その分がただになるわけではありません。2つをいつ、",
      "lineId": "v3-p1-02-l7"
    },
    {
      "start": 47.58083660130718,
      "end": 50.097333333333324,
      "speaker": "ケント",
      "text": "何のために使うかが肝心なんです。",
      "lineId": "v3-p1-02-l7"
    }
  ],
