      "end": 12.146
    },
    {
      "id": "v3-p1-02-l3",
      "speaker": "ホーマー",
      "text": "もう1つは、どこから？",
      "spokenText": "もう1つは、どこから？",
      "pauseAfter": 0.45,
      "voiceSpeed": 1.0,
      "phase": "question",
      "seconds": 1.7386666666666666,
      "audio": {
        "src": "audio/toyota-v3-p1-02/v3-p1-02-l3.wav",
        "seconds": 1.7386666666666666,
        "generatedFor": "[\"ホーマー\",\"10\",39,\"もう1つは、どこから？\",1.0]"
