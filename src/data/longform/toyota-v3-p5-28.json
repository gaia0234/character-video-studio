    },
    {
      "id": "v3-p5-28-l3",
      "speaker": "ホーマー",
      "text": "車を選ぶときに、その車だけでなく、毎日の使い方まで一緒に考える必要があるんですね。",
      "spokenText": "車を選ぶときに、その車だけでなく、毎日の使い方まで一緒に考える必要があるんですね。",
      "pauseAfter": 0.45,
      "voiceSpeed": 1.0,
      "phase": "topic",
      "seconds": 6.048,
      "audio": {
        "src": "audio/toyota-v3-p5-28/v3-p5-28-l3.wav",
