  "cues": [
    {
      "start": 0.4,
      "end": 3.422,
      "speaker": "ジャッド",
      "text": "最初は、ハイブリッドを作り続けるのは、",
      "lineId": "v3-p5-32-l1"
    },
    {
      "start": 3.422,
      "end": 5.807,
      "speaker": "ジャッド",
      "text": "電気の車へ進めていないからなの",
      "lineId": "v3-p5-32-l1"
    },
    {
      "start": 5.807,
      "end": 7.397,
      "speaker": "ジャッド",
      "text": "かと思っていました。",
      "lineId": "v3-p5-32-l1"
    },
    {
      "start": 7.847,
      "end": 9.682,
      "speaker": "ホーマー",
      "text": "でも、モーターも電池も、",
      "lineId": "v3-p5-32-l2"
    },
    {
      "start": 9.682,
      "end": 11.822,
      "speaker": "ホーマー",
      "text": "電気を取り戻して使う制御も、",
      "lineId": "v3-p5-32-l2"
    },
    {
      "start": 11.822,
      "end": 13.351,
      "speaker": "ホーマー",
      "text": "その中で磨いてきた。",
      "lineId": "v3-p5-32-l2"
    },
    {
      "start": 13.351,
      "end": 15.645,
      "speaker": "ホーマー",
      "text": "中身を見ると印象が違いますね。",
      "lineId": "v3-p5-32-l2"
    },
    {
      "start": 16.095,
      "end": 16.691,
      "speaker": "ケント",
      "text": "一方で、",
      "lineId": "v3-p5-32-l3"
    },
    {
      "start": 16.691,
      "end": 19.522,
      "speaker": "ケント",
      "text": "それだけで日本の電動化がすべて順調だと",
      "lineId": "v3-p5-32-l3"
    },
    {
      "start": 19.522,
      "end": 21.609,
      "speaker": "ケント",
      "text": "結論づけることもできません。",
      "lineId": "v3-p5-32-l3"
    },
    {
      "start": 21.609,
      "end": 22.652,
      "speaker": "ケント",
      "text": "今日見たのは、",
      "lineId": "v3-p5-32-l3"
    },
    {
      "start": 22.652,
      "end": 25.185,
      "speaker": "ケント",
      "text": "トヨタのハイブリッドが歩んだ道と、",
      "lineId": "v3-p5-32-l3"
    },
    {
      "start": 25.185,
      "end": 26.377,
      "speaker": "ケント",
      "text": "その仕組みです。",
      "lineId": "v3-p5-32-l3"
    },
    {
      "start": 26.827,
      "end": 29.293,
      "speaker": "ジャッド",
      "text": "遅れているか、進んでいるか。",
      "lineId": "v3-p5-32-l4"
    },
    {
      "start": 29.293,
      "end": 32.462,
      "speaker": "ジャッド",
      "text": "その二択に答えるより、何を積み重ね、",
      "lineId": "v3-p5-32-l4"
    },
    {
      "start": 32.462,
      "end": 35.28,
      "speaker": "ジャッド",
      "text": "どこで役に立つのかを見たほうが、",
      "lineId": "v3-p5-32-l4"
    },
    {
      "start": 35.28,
      "end": 36.865,
      "speaker": "ジャッド",
      "text": "理解が進みました。",
      "lineId": "v3-p5-32-l4"
    }
  ]
